{
    "name": "express_ts",
    "version": "1.0.0",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start:script": "node --loader ts-node/esm src/start.ts",
        "start": "node dist/app.js",
        "watch": "tsc -w",
        "server": "nodemon dist/app.js",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "dev": "concurrently \"npm run watch\"  \"npm run server\"",
        "build": "tsc --noEmitOnError false && npm run copy-views",
        "copy-views": "copyfiles -u 1 \"public/**/*\" \"src/views/**/*\" dist/",
        "prepare": "husky"
    },
